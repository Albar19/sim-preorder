generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  name               String
  role               String              @default("USER")
  phone              String?
  address            String?
  orders             Order[]
  deliveries         Delivery[]
  itemRequests       ItemRequest[]
  creditApplications CreditApplication[]
  notifications      Notification[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Item {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  price              Float
  stock              Int                 @default(0)
  imageUrl           String?
  isActive           Boolean             @default(true)
  orderItems         OrderItem[]
  creditApplications CreditApplication[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  totalAmount Float
  status      String      @default("PENDING")
  delivery    Delivery?
  notes       String?
  txHash      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Int
  price    Float
}

model Delivery {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kurirId     String
  kurir       User      @relation(fields: [kurirId], references: [id], onDelete: Cascade)
  status      String    @default("ASSIGNED")
  notes       String?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StatusLog {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  txHash      String?
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
}

model ItemRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemName    String
  description String?
  imageUrl    String?
  quantity    Int      @default(1)
  maxPrice    Float?
  status      String   @default("PENDING")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ NEW CREDIT SYSTEM MODELS ============

model CreditApplication {
  id              String        @id @default(cuid())
  applicationNo   String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity        Int           @default(1)
  itemPrice       Float         // Harga satuan saat pengajuan
  totalPrice      Float         // Total harga (quantity * itemPrice)
  tenor           Int           // Jumlah bulan cicilan (3, 6, 12)
  monthlyAmount   Float         // Jumlah cicilan per bulan
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED, CANCELLED
  notes           String?       // Catatan dari user
  adminNotes      String?       // Catatan dari owner
  approvedAt      DateTime?
  rejectedAt      DateTime?
  installments    Installment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Installment {
  id              String            @id @default(cuid())
  applicationId   String
  application     CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  installmentNo   Int               // Cicilan ke-1, 2, 3, dst
  amount          Float             // Jumlah yang harus dibayar
  dueDate         DateTime          // Tanggal jatuh tempo
  paidAmount      Float             @default(0)
  paidAt          DateTime?
  status          String            @default("UNPAID") // UNPAID, PAID, OVERDUE
  paymentProof    String?           // URL bukti pembayaran
  confirmedBy     String?           // ID owner yang konfirmasi
  confirmedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // PAYMENT_DUE, PAYMENT_REMINDER, APPLICATION_APPROVED, APPLICATION_REJECTED
  link      String?  // Link untuk navigasi
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
